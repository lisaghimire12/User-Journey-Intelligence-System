# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (recommended for production use).
# If left unset, the app falls back to a local SQLite file at
# data/local_dev.db so it can run without a Postgres server.
DATABASE_URL=postgresql://username:password@localhost:5432/user_journey_db

# Used to derive pseudonymous session/user tokens (HMAC key). Change this
# to a random value for any real deployment.
PSEUDONYMIZATION_SALT=change-me-in-.env

# Configurable data retention window, in days.
DATA_RETENTION_DAYS=90

# Synthetic data generation
SYNTHETIC_SESSIONS=6000
RANDOM_SEED=42

# App behavior
CACHE_TTL_SECONDS=300
AUTO_REFRESH_ENABLED=true

# Optional LLM (leave blank to run with the deterministic explanation
# engine only -- causal inference, simulation, and recommendation
# scoring never use an LLM regardless of this setting).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
